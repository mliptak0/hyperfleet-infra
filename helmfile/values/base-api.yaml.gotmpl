# Base values for HyperFleet API

replicaCount: 2

{{ $obs := eq (env "OBSERVABILITY_ENABLED" | default "false") "true" }}
{{ $tracing := eq (env "TRACING_ENABLED" | default "false") "true" }}
{{ $mode := .Values.authMode }}
{{ $jwtEnabled := has $mode (list "API" "EDGE+API") }}
{{ $tenantIsolationEnabled := eq (env "TENANT_ISOLATION_ENABLED" | default "false") "true" }}
{{ $tenantModel := env "TENANT_MODEL" | default "onprem" }}
{{ if and $tenantIsolationEnabled (not (has $mode (list "EDGE" "EDGE+API"))) }}
{{ fail "TENANT_ISOLATION_ENABLED=true requires AUTH_MODE=EDGE or EDGE+API: the API consumes trusted gateway tenant headers" }}
{{ end }}
{{ if and (eq $mode "API") (not (and (regexMatch "^https://[^/]+" .Values.security.kubernetesJWT.issuerUrl) (regexMatch "^https://[^/]+" .Values.security.kubernetesJWT.jwksUrl))) }}
{{ fail "AUTH_MODE=API requires HTTPS security.kubernetesJWT.issuerUrl and security.kubernetesJWT.jwksUrl values" }}
{{ end }}
{{ $allowedSAs := list }}
{{ range .Values.sentinels }}{{ $allowedSAs = append $allowedSAs (regexQuoteMeta (printf "%s-hyperfleet-sentinel" .name)) }}{{ end }}
{{ range .Values.adapters }}{{ $allowedSAs = append $allowedSAs (regexQuoteMeta (printf "%s-hyperfleet-adapter" .name)) }}{{ end }}
{{ if or $obs $tracing }}
monitoring:
  {{ if $obs }}
  serviceMonitor:
    enabled: true
  prometheusRule:
    enabled: true
  dashboard:
    enabled: true
  {{ end }}
  {{ if $tracing }}
  tracing:
    enabled: true
    otlpEndpoint: "http://otel-collector.{{ env "MONITORING_NAMESPACE" | default "monitoring" }}.svc.cluster.local:4317"
  {{ end }}
{{ end }}

image:
  registry: {{ env "REGISTRY" | default "quay.io" }}
  repository: {{ env "API_REPOSITORY" | default "redhat-services-prod/hyperfleet-tenant/hyperfleet/hyperfleet-api" }}
  tag: {{ env "API_IMAGE_TAG" | default "dev" }}
  pullPolicy: {{ env "IMAGE_PULL_POLICY" | default "IfNotPresent" }}

service:
  # hyperfleet-gateway is the intended external entry point (see its own
  # gatewayServiceType wiring in helmfile.yaml.gotmpl) — hyperfleet-api itself
  # stays ClusterIP so it can't be reached directly, bypassing gateway header stripping.
  type: ClusterIP

extraVolumes:
  - name: api-tls
    secret:
      secretName: {{ .Values.security.tls.hyperfleetApiTLSSecretName }}
      items:
        - key: tls.crt
          path: tls.crt
        - key: tls.key
          path: tls.key
  # The API uses this CA only in EDGE+API to trust Authorino's HTTPS
  # wristband discovery and JWKS endpoint.
  - name: gateway-ca
    secret:
      secretName: hyperfleet-gateway-ca-cert
      items:
        - key: ca.crt
          path: ca.crt
extraVolumeMounts:
  - name: api-tls
    mountPath: /etc/hyperfleet/tls
    readOnly: true
  - name: gateway-ca
    mountPath: /etc/hyperfleet/pki
    readOnly: true

config:
  entities:
    - kind: Cluster
      plural: clusters
      spec_schema_name: ClusterSpec
      required_adapters:
        {{- range .Values.adapters }}
        {{- if eq .resourceType "clusters" }}
        - {{ .name }}
        {{- end }}
        {{- end }}
      references:
        - ref_type: wif_config
          target_kind: WifConfig
          min: 0
          max: 1
      name_min_len: 3
      name_max_len: 53
      require_spec_schema: true
    - kind: NodePool
      plural: nodepools
      parent_kind: Cluster
      on_parent_delete: cascade
      spec_schema_name: NodePoolSpec
      required_adapters:
        {{- range .Values.adapters }}
        {{- if eq .resourceType "nodepools" }}
        - {{ .name }}
        {{- end }}
        {{- end }}
      name_min_len: 3
      name_max_len: 15
      require_spec_schema: true
    - kind: Channel
      plural: channels
      spec_schema_name: ChannelSpec
    - kind: Version
      plural: versions
      parent_kind: Channel
      on_parent_delete: restrict
      spec_schema_name: VersionSpec
    - kind: WifConfig
      plural: wifconfigs
      spec_schema_name: WifConfigSpec
  server:
    tls:
      enabled: true
      cert_file: /etc/hyperfleet/tls/tls.crt
      key_file: /etc/hyperfleet/tls/tls.key
    tenant:
      enabled: {{ $tenantIsolationEnabled }}
      {{ if $tenantIsolationEnabled }}
      system_header: x-hyperfleet-system
      dimensions:
      {{ if eq $tenantModel "onprem" }}
        - header: x-tenant-org
          key: org
          required: true
        - header: x-tenant-project
          key: project
          required: false
      {{ else if eq $tenantModel "oracle" }}
        - header: x-tenant-tenancy-ocid
          key: tenancy_ocid
          required: true
        - header: x-tenant-compartment
          key: compartment_id
          required: false
      {{ else }}
        {{ fail (printf "TENANT_MODEL %q is not supported (expected onprem or oracle)" $tenantModel) }}
      {{ end }}
      {{ end }}
    jwt:
      enabled: {{ $jwtEnabled }}
      {{ if $jwtEnabled }}
      configs:
      {{ if eq $mode "EDGE+API" }}
        {{ $issuer := printf "https://authorino-authorino-oidc.%s.svc:8083/%s/hyperfleet-tenant-policy/wristband" .Values.namespace .Values.namespace }}
        - issuer_url: {{ $issuer | quote }}
          jwk_cert_url: {{ printf "%s/.well-known/openid-connect/certs" $issuer | quote }}
          jwk_cert_ca_file: /etc/hyperfleet/pki/ca.crt
          header: Authorization
          audience: hyperfleet-api
          identity_claim: sub
      {{ else }}
        # API-only mode validates the configured external issuers directly.
        # It cannot exchange credentials for wristbands without edge auth.
        - issuer_url: {{ .Values.security.kubernetesJWT.issuerUrl | quote }}
          jwk_cert_url: {{ .Values.security.kubernetesJWT.jwksUrl | quote }}
          jwk_cert_ca_file: {{ .Values.security.kubernetesJWT.caFile | quote }}
          header: Authorization
          audience: {{ .Values.machineIdentityAudience | quote }}
          identity_claim: sub
          identity_claim_pattern: {{ printf "^system:serviceaccount:%s:(%s)$" .Values.namespace (join "|" $allowedSAs) | quote }}
        {{ range .Values.security.identityProviders }}
        {{ if not (and (regexMatch "^https://[^/]+" .issuerUrl) (regexMatch "^https://[^/]+" .jwksUrl)) }}
        {{ fail "API mode requires HTTPS issuerUrl and jwksUrl for every security.identityProviders entry" }}
        {{ end }}
        - issuer_url: {{ .issuerUrl | quote }}
          jwk_cert_url: {{ .jwksUrl | quote }}
          audience: {{ required "Every identity provider requires an audience" .audience | quote }}
          identity_claim: {{ default "sub" .identityClaim | quote }}
          identity_claim_pattern: {{ default "" .identityClaimPattern | quote }}
        {{ end }}
      {{ end }}
      {{ else }}
      configs: []
      {{ end }}
